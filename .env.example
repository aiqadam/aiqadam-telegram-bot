# Copy to .env for local development. Never commit the real .env.
#
# Thin-bot guarantee (FR-BOT-001 AC-10): this file must never grow a
# DIRECTUS_TOKEN, AUTHENTIK_API_TOKEN, or TWENTY_API_TOKEN entry. Every
# other integration is reached indirectly through the NestJS API using
# INTERNAL_API_TOKEN below.

# Telegram Bot API token issued by @BotFather.
TELEGRAM_BOT_TOKEN=

# Base URL of the aiqadam NestJS API (no trailing slash needed).
INTERNAL_API_URL=https://uz.aiqadam.org/api

# Shared secret sent as the x-internal-auth header on every internal API
# call. Must match apps/api's INTERNAL_API_TOKEN env var exactly.
INTERNAL_API_TOKEN=

# Optional overrides (sane defaults if unset):
# BOT_SQLITE_PATH=data/bot-cache.sqlite3
# BOT_RATE_LIMIT_PER_MINUTE=10
# BOT_HTTP_TIMEOUT_SECONDS=5.0
# BOT_LOG_LEVEL=INFO
